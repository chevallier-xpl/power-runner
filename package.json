{
  "name": "powerrunner",
  "productName": "PowerRunner",
  "version": "1.2.1",
  "license": "MIT",
  "main": "electron/main.js",
  "engines": {
    "node": "^24.15.0",
    "npm": "^12.1.0"
  },
  "packageManager": "npm@12.1.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build && SET NODE_ENV=dev && electron ./dist/electron/main.js",
    "build": "tsc -p tsconfig.electron.json && ng build --configuration development --base-href ./ && copyfiles ./src/electron/preload.js ./dist/powerrunner --up 2",
    "build-prod": "tsc -p tsconfig.electron.json && ng build --configuration production --base-href ./ && copyfiles ./src/electron/preload.js ./dist/powerrunner --up 2",
    "copy-deps": "copyfiles ./package.json ./dist && copyfiles ./src/electron/powershell/*.ps1 ./dist --up 1 && copyfiles ./node_modules/**/*.* ./dist && copyfiles ./src/electron/preload.js ./dist/powerrunner --up 2",
    "package": "npm run copy-deps && npm run build-prod && electron-packager ./dist --overwrite --out=./release",
    "installer": "node installer.js",
    "package-installer": "npm run package && npm run installer",
    "electron-rebuild": "electron-rebuild",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --progress=false",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~22.2.0",
    "@angular/cdk": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/material": "~22.2.0",
    "@angular/material-moment-adapter": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-browser-dynamic": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@types/underscore": "^1.11.3",
    "angular-split": "^20.0.0",
    "electron-is-dev": "^2.0.0",
    "electron-squirrel-startup": "^1.0.0",
    "electron-unhandled": "^3.0.2",
    "esm": "^3.2.25",
    "fs-extra": "^10.0.0",
    "globby": "^11.0.4",
    "is-elevated": "^3.0.0",
    "katex": "^0.16.47",
    "moment": "^2.30.1",
    "ngx-markdown": "^22.1.0",
    "marked-katex-extension": "^5.1.13",
    "node-abi": "^2.30.0",
    "node-fetch": "^2.6.1",
    "node-pty": "^0.10.1",
    "node-yaml": "^4.0.1",
    "rxjs": "~7.8.2",
    "sqlite3": "^4.1.1",
    "ts-md5": "^1.2.9",
    "tslib": "^2.3.0",
    "underscore": "^1.13.1",
    "xregexp": "^5.0.2",
    "xterm": "^4.13.0",
    "xterm-addon-fit": "^0.5.0",
    "xterm-addon-search": "^0.8.0",
    "xterm-addon-web-links": "^0.4.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^16.4.13",
    "@types/sqlite3": "^3.1.7",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.5.0",
    "copyfiles": "^2.4.1",
    "electron": "^44.4.5",
    "electron-packager": "^15.3.0",
    "@electron/rebuild": "^4.2.0",
    "electron-reload": "^1.5.0",
    "electron-winstaller": "^5.0.0",
    "eslint": "^10.11.0",
    "jasmine-core": "~5.13.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "ts-node": "~10.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "build": {
    "extraResources": [
      "./electron/powershell/**"
    ]
  }
}
